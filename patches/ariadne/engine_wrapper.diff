 class LanGuideMedSegWrapper(pl.LightningModule):
 
+    @property
+    def _cfg(self):
+        # PL>=1.x stores the config under its init-arg name; fall back to it when keys aren't flat
+        h = self.hparams
+        if "lr" in h:
+            return h
+        for v in h.values():
+            if hasattr(v, "lr") or (isinstance(v, dict) and "lr" in v):
+                return v
+        return h
+
     def __init__(self, args):
         
         super(LanGuideMedSegWrapper, self).__init__()
